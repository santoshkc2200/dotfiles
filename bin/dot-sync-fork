#!/usr/bin/env bash
#
# sync-fork.sh
#
# Syncs your fork ("origin") with the original repo ("upstream"),
# then pushes the result back to your fork.
#
# Usage:
#   ./dot-sync-fork                 # sync "main" branch using merge
#   ./dot-sync-fork develop         # sync a different branch
#   ./dot-sync-fork main rebase     # use rebase instead of merge
#
# First-time setup (only needed once per clone):
#   git remote add upstream <URL-of-original-repo>
#
# What it does:
#   1. Fetches the latest changes from "upstream"
#   2. Checks out your local branch
#   3. Merges (or rebases) upstream/<branch> into it
#   4. If there's a conflict, it stops and tells you exactly what to do
#   5. If clean, it pushes the result to "origin" (your fork)

set -euo pipefail

BRANCH="${1:-main}"
MODE="${2:-merge}"          # "merge" or "rebase"
UPSTREAM="upstream"
ORIGIN="origin"

echo "=================================================="
echo " Syncing '$BRANCH' from '$UPSTREAM' -> '$ORIGIN'"
echo " Mode: $MODE"
echo "=================================================="

# --- Sanity checks -------------------------------------------------

if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  echo "Error: not inside a git repository."
  exit 1
fi

if ! git remote | grep -qx "$UPSTREAM"; then
  echo "Error: remote '$UPSTREAM' not found."
  echo "Add it first, e.g.:"
  echo "  git remote add upstream https://github.com/<original-owner>/<repo>.git"
  exit 1
fi

if ! git diff-index --quiet HEAD -- 2>/dev/null; then
  echo "Error: you have uncommitted local changes."
  echo "Commit, stash, or discard them before syncing."
  echo "  git stash        # to stash them temporarily"
  exit 1
fi

# --- Fetch upstream --------------------------------------------------

echo ""
echo "==> Fetching latest changes from $UPSTREAM..."
git fetch "$UPSTREAM"

# --- Checkout target branch ------------------------------------------

echo ""
echo "==> Checking out local branch '$BRANCH'..."
git checkout "$BRANCH"

# --- Merge or rebase --------------------------------------------------

echo ""
echo "==> Integrating $UPSTREAM/$BRANCH using $MODE..."

set +e
if [ "$MODE" = "rebase" ]; then
  git rebase "$UPSTREAM/$BRANCH"
  STATUS=$?
else
  git merge "$UPSTREAM/$BRANCH" -m "Merge $UPSTREAM/$BRANCH into $BRANCH"
  STATUS=$?
fi
set -e

if [ $STATUS -ne 0 ]; then
  echo ""
  echo "!! Conflict detected while syncing with $UPSTREAM/$BRANCH."
  echo ""
  echo "   1. Resolve the conflicts in the files listed above"
  echo "      (git status shows them)"
  echo "   2. Stage the fixes:      git add <file>..."
  if [ "$MODE" = "rebase" ]; then
    echo "   3. Continue the rebase:  git rebase --continue"
    echo "      (or abort with:      git rebase --abort)"
  else
    echo "   3. Finish the merge:     git commit"
    echo "      (or abort with:      git merge --abort)"
  fi
  echo "   4. Re-run this script to push once resolved,"
  echo "      or push manually:      git push $ORIGIN $BRANCH"
  echo ""
  exit 1
fi

# --- Push to your fork --------------------------------------------------

echo ""
echo "==> No conflicts. Pushing '$BRANCH' to '$ORIGIN' (your fork)..."

if [ "$MODE" = "rebase" ]; then
  # Rebase rewrites history, so a force push (safely) is required.
  git push "$ORIGIN" "$BRANCH" --force-with-lease
else
  git push "$ORIGIN" "$BRANCH"
fi

echo ""
echo "=================================================="
echo " Done. '$BRANCH' is now in sync with $UPSTREAM"
echo " and pushed to $ORIGIN."
echo "=================================================="